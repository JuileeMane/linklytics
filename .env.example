# ==============================================================================
# LinkLytics — Environment Variables Template
# ==============================================================================

# ----------------- BACKEND CONFIGURATION (Spring Boot) -----------------
# Server port (defaults to 8080 locally; cloud platforms provide PORT)
PORT=8080

# PostgreSQL Database Connection
# Local PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/linklytics
# Cloud PostgreSQL (Neon / Supabase / Render):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xyz.us-east-2.aws.neon.tech/linklytics?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/linklytics
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# Hibernate DDL Mode (update automatically creates/updates tables on startup)
DDL_AUTO=update

# JWT Secret (minimum 256 bits / 32 characters)
JWT_SECRET=linklyticsSuperSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026LinkLyticsBTechProject

# JWT Expiration in Milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Backend Public Base URL (Used for generating short links e.g. http://localhost:8080 or https://linklytics.onrender.com)
APP_BASE_URL=http://localhost:8080

# Frontend URL (Used for password challenge redirects)
FRONTEND_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ----------------- FRONTEND CONFIGURATION (Vite React) -----------------
# Leave blank for local development (Vite dev proxy forwards /api and /r to localhost:8080)
# Set to your deployed backend URL in production (e.g. https://linklytics-backend.onrender.com)
VITE_BACKEND_URL=
